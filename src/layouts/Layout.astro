---
import { site, absoluteUrl } from "../site";
import type { JSONLDEntry } from "../types";

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonld?: JSONLDEntry[];
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  keywords = site.keywords,
  path = "/",
  ogImage = "/og-home.png",
  ogImageAlt,
  jsonld = [],
} = Astro.props;

const canonical = absoluteUrl(path);
const fullTitle = path === "/"
  ? `${site.name} — ${site.tagline}`
  : title.includes("Dunite Labs")
    ? title
    : `${title} | ${site.name}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : absoluteUrl(ogImage);
const orgId = `${site.url}/#organization`;
const webId = `${site.url}/#website`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: site.name,
      legalName: site.legalName,
      alternateName: site.alternateNames,
      url: site.url,
      description: site.description,
      slogan: site.tagline,
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl("/favicon-512.png"),
        width: 512,
        height: 512,
      },
      image: absoluteUrl("/og-home.png"),
      email: site.email,
      foundingDate: site.foundingDate,
      foundingLocation: { "@type": "Place", name: "India" },
      areaServed: "Worldwide",
      knowsAbout: site.knowsAbout,
      sameAs: Object.values(site.social),
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "customer support",
          email: site.email,
          availableLanguage: ["en", "hi"],
        },
      ],
    },
    {
      "@type": "WebSite",
      "@id": webId,
      url: site.url,
      name: site.name,
      alternateName: site.alternateNames,
      description: site.description,
      inLanguage: "en",
      publisher: { "@id": orgId },
    },
    ...jsonld,
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#F7F3EE" />
    <meta name="author" content={site.name} />
    <meta name="publisher" content={site.name} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="google-site-verification" content="38God-0JWxF8XBCSKF-P4Qdz_ayaOKF7WHfDi_FA5Yw" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? fullTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? fullTitle} />

    <!-- Icons: Google reads the raster 48px+ entries, not the SVG -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#0E0E0E" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style is:global>
      :root{
        --bg:#F7F3EE;
        --ink:#0E0E0E;
        --line:#0E0E0E;
        --muted:#6B6B6B;
        --card:#ffffff;              /* raised surface: cards, panels */
        --card-2:#F7F3EE;            /* inset surface: chips, subtle fills */
        --body:#333333;              /* secondary body copy */
        --hair:rgba(14,14,14,0.10);  /* hairlines / dividers */
        /* Single page-width token: every page's content container uses this so
           the whole site lines up on the same grid. */
        --page-w:1280px;
      }
      html[data-theme="dark"], :root[data-theme="dark"], [data-theme="dark"]{
        --bg:#0A0A0A;
        --ink:#F7F3EE;
        --line:#F7F3EE;
        --muted:#9A9A9A;
        --card:#1A1A1A;
        --card-2:#232323;
        --body:#CFCFCF;
        --hair:rgba(247,243,238,0.12);
      }
      *{box-sizing:border-box}
      html,body{margin:0; padding:0}
      html{scroll-behavior:smooth}
      body{
        background:var(--bg);
        color:var(--ink);
        font-family:"Space Grotesk", system-ui, sans-serif;
        -webkit-font-smoothing:antialiased;
        transition: background 200ms, color 200ms;
      }
      a{color:inherit; text-decoration:none}
      ::selection{background:var(--ink); color:var(--bg)}
      /* dark overrides */
      html[data-theme="dark"] body{ background:var(--bg); color:var(--ink) }
      html[data-theme="dark"] .page{
        background: radial-gradient(ellipse 1200px 500px at 20% -10%, #1A1A1A 0%, transparent 60%), linear-gradient(#ffffff0a 1px, transparent 1px), linear-gradient(90deg, #ffffff0a 1px, transparent 1px) !important;
        background-color:var(--bg) !important;
      }
      html[data-theme="dark"] .eyebrow,
      html[data-theme="dark"] .work-label,
      html[data-theme="dark"] .strip,
      html[data-theme="dark"] .work-note,
      html[data-theme="dark"] .app-card,
      html[data-theme="dark"] .hero-rail,
      html[data-theme="dark"] .card.feature,
      html[data-theme="dark"] .card.quote,
      html[data-theme="dark"] .doc-head,
      html[data-theme="dark"] .sections,
      html[data-theme="dark"] .showcase .kicker,
      html[data-theme="dark"] .showcase .pill,
      html[data-theme="dark"] .next-card,
      html[data-theme="dark"] .next-kicker,
      html[data-theme="dark"] .card-caption.boundary,
      html[data-theme="dark"] .feat-list li,
      html[data-theme="dark"] .pill.ghost{
        background:var(--card) !important;
        color:var(--ink) !important;
        border-color:var(--line) !important;
      }
      html[data-theme="dark"] .strip .arrow,
      html[data-theme="dark"] .strip .pill:not(.ghost){
        border-color:var(--line) !important;
      }
      html[data-theme="dark"] .strip-icon{ border-color:var(--line) !important; }
      html[data-theme="dark"] .strip-num{ -webkit-text-stroke-color:var(--ink) }
      html[data-theme="dark"] .tagline{ color:var(--ink) }
      html[data-theme="dark"] .hero{ border-color:var(--line); background:var(--bg) }
      html[data-theme="dark"] .brand, html[data-theme="dark"] .line2{ color:var(--ink) !important }
      html[data-theme="dark"] .line1{ -webkit-text-stroke-color:var(--ink) }
      html[data-theme="dark"] .show-head p{ color:#CFCFCF }
      html[data-theme="dark"] .builder{ background:var(--card); border-color:var(--line) }
      html[data-theme="dark"] .grain{ opacity:0.06 }
      /* individual project page fixes */
      html[data-theme="dark"] .showcase .show-head{ border-color:var(--line) }
      html[data-theme="dark"] .showcase h2{ color:var(--ink) }
      html[data-theme="dark"] .card-top{ background:var(--card) !important; border-color:var(--line) !important; color:var(--ink) !important; }
      html[data-theme="dark"] .thumb-label{ color:var(--ink); }
      html[data-theme="dark"] .hint{ color:var(--muted) }
      html[data-theme="dark"] .next-count{ color:var(--muted) }
      html[data-theme="dark"] .mini-foot{ border-color:var(--line); color:var(--muted) }
      html[data-theme="dark"] .stats .stat{ background:#ffffff0a; border-color:#ffffff18 }
      /* keep logo & footer always dark - white logo needs dark bg */
      html[data-theme="dark"] .logo-mark{ background:#0E0E0E !important; border-color:#2A2A2A !important; box-shadow:6px 6px 0 #000 !important; }
      html[data-theme="dark"] .foot{ background:#0E0E0E !important; color:#F7F3EE !important; border-color:#2A2A2A !important; }
      html[data-theme="dark"] .foot .foot-big{ -webkit-text-stroke-color:#ffffff18; border-color:#ffffff14 }
      html[data-theme="dark"] .topbar .back{ background:#0E0E0E !important; color:#fff !important; border-color:#2A2A2A !important; }
      @media(max-width:768px){
        #theme-toggle{ width:36px !important; height:36px !important; font-size:15px !important; box-shadow:2px 2px 0 var(--line) !important; }
      }
    </style>
    <script is:inline>
      (function(){
        const key='dunite-theme';
        try{
          const saved=localStorage.getItem(key);
          document.documentElement.setAttribute('data-theme', saved || 'light');
        }catch(e){}
        window.toggleTheme=function(){
          const cur=document.documentElement.getAttribute('data-theme') || 'light';
          const next=cur==='dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try{ localStorage.setItem(key, next); }catch(e){}
          const btn=document.getElementById('theme-toggle-icon');
          if(btn) btn.textContent= next==='dark' ? '☀' : '☾';
        };
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function(){
        const icon=document.getElementById('theme-toggle-icon');
        const cur=document.documentElement.getAttribute('data-theme');
        if(icon) icon.textContent= cur==='dark' ? '☀' : '☾';
      })();
    </script>
  </body>
</html>
