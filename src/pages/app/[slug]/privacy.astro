---
import Layout from "../../../layouts/Layout.astro";
import { apps } from "../../../data/apps.ts";
import { site } from "../../../site";

export function getStaticPaths() {
  return apps.map(a => ({ params: { slug: a.slug } }));
}
const { slug } = Astro.params;
const app = apps.find(a => a.slug === slug)!;
const jsonld = [
  {
    "@type": "WebPage",
    name: "SpeedMaths Pro — Privacy Policy",
    description: "Privacy policy for SpeedMaths Pro mental‑math trainer.",
    url: `/app/${app.slug}/privacy/`,
    isPartOf: { "@type": "WebSite", name: "Dunite Labs", url: site.url },
  },
];
---

<Layout
  title="SpeedMaths Pro — Privacy Policy — Dunite Labs"
  description="Privacy policy for SpeedMaths Pro mental‑math trainer."
  favicon={app.icon}
  path={`/app/${app.slug}/privacy/`}
  jsonld={jsonld}
  date="22 Oct 2026"
>
  <div class="page" style={`--accent:${app.accent}`}>
    <div class="topbar">
      <a href={`/app/${app.slug}`} class="back"><img src="/dunitelabs_logo.svg" alt="" width="20" height="20" /> Back to {app.name}</a>
      <span class="top-mono">LEGAL • PRIVACY POLICY</span>
      <button id="theme-toggle" type="button" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Light / Dark" style="width:36px; height:36px; border-radius:50%; border:2px solid var(--line); background:var(--card); color:var(--ink); box-shadow:3px 3px 0 var(--line); cursor:pointer; display:grid; place-items:center; font-size:16px; flex-shrink:0;"><span id="theme-toggle-icon">☾</span></button>
    </div>

    <article class="doc">
      <div class="doc-head">
        <div class="app-badge" style={`background:${app.bg}; color:${app.accent}; border-color:var(--line)`}>
          {app.icon.startsWith("/") ? <img src={app.icon} alt="" /> : <span>{app.icon}</span>}
          <span>{app.name}</span>
        </div>
        <h1>SpeedMaths Pro — Privacy Policy</h1>
        <p class="last">Last updated: 22 Oct 2026</p>
        <p class="intro">SpeedMaths Pro is a mental‑math trainer for competitive‑exam aspirants. We collect the minimum data needed for the leaderboard, streak sync and offline practice, and we never sell your data.</p>
        <div class="links">
          <a href={`/app/${app.slug}/delete-data`} class="link">Delete my data →</a>
          <span class="sep">•</span>
          <a href="/" class="link">Dunite Labs home</a>
        </div>
      </div>

      <div class="sections">
        <section>
          <h2>What data we collect</h2>
          <p>When you first open SpeedMaths Pro, Firebase creates an anonymous authentication ID. This random identifier lets the app save your daily leaderboard score and keep your streak in sync across devices. No email, phone number, or personal details are required.</p>
          <p>The leaderboard stores your score, average time, and an optional display name in Cloud Firestore under a day‑specific document. A separate user profile document holds your chosen reminder time, theme preference, and streak counters — all optional.</p>
          <p>All practice history — quiz results, level progress, custom‑practice settings, and the list of questions you answered incorrectly — stays in a local SQLite database on your device. App preferences such as theme, reminder time, and the onboarding flag are saved in SharedPreferences. None of this data leaves your phone unless you explicitly use the in‑app sync feature.</p>
          <p><strong>We do not collect</strong> email addresses, phone numbers, contacts, precise location, camera or microphone access, advertising IDs, or any other personally‑identifiable information.</p>
        </section>

        <section>
          <h2>Permissions</h2>
          <p>The app requests only the Internet permission, which is required for Firebase Authentication and Firestore. No sensitive permissions — such as location, contacts, camera, microphone, SMS, or call logs — are requested.</p>
        </section>

        <section>
          <h2>Third‑party services</h2>
          <p>We use three Google services: Firebase Authentication (anonymous sign‑in) to generate a random user ID; Cloud Firestore to store leaderboard rows and optional profile data; and Google Play Services, which Firebase depends on. We do not use any of the identifiers from Play Services ourselves. All three are covered by Google's own privacy policies and Data‑Processing Addendum.</p>
        </section>

        <section>
          <h2>Data retention & security</h2>
          <p>All network traffic is encrypted with TLS 1.2 or higher (Firebase enforces HTTPS). The on‑device SQLite database lives in the app's private sandbox — no other app can read it. No data is written to external storage.</p>
          <p>Leaderboard documents are kept for a rolling 30‑day window and then removed automatically by a Cloud Function. Your Firestore user profile remains until you request deletion (see the Delete Your Data page). Local data and preferences stay on your device until you tap <strong>Delete my data</strong> in the app or clear the app's storage from Android Settings.</p>
        </section>

        <section>
          <h2>Children's privacy</h2>
          <p>SpeedMaths Pro is not directed to children under 13 (or the local equivalent). We do not knowingly collect data from children. If a parent discovers a child has entered a display name, contact us and we will delete it immediately.</p>
        </section>

        <section>
          <h2>Your rights</h2>
          <p>You can view a summary of your data in the app's Profile screen. You may edit your display name and reminder time at any time. To erase everything, open <strong>Profile → Settings → Delete my data</strong>, or email us at <a href="mailto:dunitelabs.support@gmail.com">dunitelabs.support@gmail.com</a> with the subject "Delete my SpeedMaths Pro data" and the UID shown in Profile → About. We will confirm deletion within 48 hours. If you prefer, you can also request a JSON export of your data by email.</p>
        </section>

        <section>
          <h2>Changes to this policy</h2>
          <p>Any material change will be posted on this page with a new "Last updated" date. The in‑app link always points to the current version.</p>
        </section>

        <section class="contact">
          <h2>Contact</h2>
          <p>Email: <a href="mailto:dunitelabs.support@gmail.com">dunitelabs.support@gmail.com</a> — we reply within 7 days. For Play Store, this page (<code>/app/speedmaths-pro/privacy/</code>) is the official privacy‑policy URL.</p>
        </section>
      </div>

      <div class="doc-foot">
        <a href={`/app/${app.slug}`} class="back dark">← Back to {app.name}</a>
        <span>© {new Date().getFullYear()} Dunite Labs</span>
      </div>
    </article>
  </div>

<style>
  .page{ min-height:100dvh; background:#F7F3EE; padding-bottom:24px }
  .topbar{ max-width:860px; margin:0 auto; padding:14px 22px; display:flex; justify-content:space-between; gap:12px; align-items:center; font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.1em }
  .back{ display:flex; align-items:center; gap:8px; background:#0E0E0E; color:#fff; border:1.5px solid #0E0E0E; padding:6px 12px; font-weight:700; box-shadow:3px 3px 0 #0E0E0E }
  .back.dark{ background:#fff; color:#0E0E0E; border-color:#0E0E0E }
  .back img{ width:20px; height:20px }
  .top-mono{ opacity:0.6 }
  .doc{ max-width:860px; margin:0 auto; padding:0 22px }
  .doc-head{ background:#fff; border:2px solid var(--line); padding:22px; box-shadow:6px 6px 0 var(--line); margin-top:8px }
  .app-badge{ display:inline-flex; align-items:center; gap:8px; border:1.5px solid; padding:6px 10px; font-family:"Space Grotesk", sans-serif; font-weight:700; font-size:13px }
  .app-badge img{ width:22px; height:22px; object-fit:contain; background:#fff; border-radius:6px; padding:2px }
  h1{ margin:14px 0 6px; font-family:"Bricolage Grotesque", sans-serif; font-size:32px; letter-spacing:-0.04em; line-height:1 }
  .last{ font-family:"JetBrains Mono", monospace; font-size:11px; opacity:0.6; margin:0 }
  .intro{ margin:12px 0 0; font-family:"Instrument Serif", serif; font-size:18px; line-height:1.4 }
  .links{ margin-top:12px; display:flex; gap:10px; align-items:center; font-family:"JetBrains Mono", monospace; font-size:11px }
  .link{ border-bottom:1.5px solid var(--line); }
  .sep{ opacity:0.4 }
  .sections{ margin-top:16px; background:#fff; border:2px solid var(--line); padding:22px; box-shadow:6px 6px 0 var(--line) }
  section{ padding:14px 0; border-bottom:1px solid #00000012 }
  section:last-child{ border-bottom:none }
  h2{ margin:0 0 6px; font-family:"Space Grotesk", sans-serif; font-size:15px; letter-spacing:-0.02em }
  p{ margin:0 0 12px; font-size:14px; line-height:1.7; opacity:0.85 }
  .contact a{ text-decoration:underline }
  .doc-foot{ display:flex; justify-content:space-between; gap:12px; align-items:center; margin-top:16px; font-family:"JetBrains Mono", monospace; font-size:11px }
  @media(max-width:768px){
    .topbar{ padding:10px 14px; flex-wrap:wrap; gap:8px; }
    .back{ padding:5px 9px; font-size:11px; box-shadow:2px 2px 0 #0E0E0E; order:1; }
    #theme-toggle{ order:2; margin-left:auto; }
    .top-mono{ font-size:9px; width:100%; text-align:left; order:3; }
    .doc{ padding:0 14px; }
    .doc-head{ padding:16px; box-shadow:4px 4px 0 var(--line); }
    h1{ font-size:clamp(22px, 6vw, 28px); }
    .intro{ font-size:16px; }
    .links{ flex-wrap:nowrap; gap:6px; font-size:clamp(9.5px, 2.6vw, 10px); justify-content:flex-start; white-space:nowrap; max-width:100%; overflow:hidden; }
    .links a{ white-space:nowrap; padding:4px 2px; flex-shrink:1; min-width:0; }
    .links .sep{ flex-shrink:0; }
    .sections{ padding:16px; box-shadow:4px 4px 0 var(--line); }
    .doc-foot{ flex-direction:column; align-items:stretch; text-align:center; }
    .doc-foot .back{ justify-content:center; }
  }
</style>
</Layout>