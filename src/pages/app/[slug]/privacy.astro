---
import Layout from "../../../layouts/Layout.astro";
import { apps } from "../../../data/apps.ts";
import { site } from "../../../site";

export function getStaticPaths() {
  // The only policy still written inline here is SpeedMaths Pro's. Guava Music has its own
  // pages (src/pages/app/guava-music/) and every other app has no policy at all, so neither
  // may inherit this text - a policy for the wrong app is worse than no page.
  return apps.filter(a => a.slug === 'speedmaths-pro').map(a => ({ params: { slug: a.slug } }));
}
const { slug } = Astro.params;
const app = apps.find(a => a.slug === slug)!;
const jsonld = [
  {
    "@type": "WebPage",
    name: "SpeedMaths Pro — Privacy Policy",
    description: "Privacy policy for SpeedMaths Pro mental‑math trainer.",
    url: `/app/${app.slug}/privacy/`,
    isPartOf: { "@type": "WebSite", name: "Dunite Labs", url: site.url },
  },
];
---

<Layout
  title="SpeedMaths Pro — Privacy Policy — Dunite Labs"
  description="Privacy policy for SpeedMaths Pro mental‑math trainer."
  path={`/app/${app.slug}/privacy/`}
  jsonld={jsonld}
  date="23 Nov 2026"
>
  <div class="page" style={`--accent:${app.accent}`}>
    <div class="topbar">
      <a href={`/app/${app.slug}/`} class="back"><img src="/dunitelabs_logo.svg" alt="" width="20" height="20" /> Back to {app.name}</a>
      <span class="top-mono">LEGAL • PRIVACY POLICY • v1.3</span>
      <button id="theme-toggle" type="button" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Light / Dark" style="width:36px; height:36px; border-radius:50%; border:2px solid var(--line); background:var(--card); color:var(--ink); box-shadow:3px 3px 0 var(--line); cursor:pointer; display:grid; place-items:center; font-size:16px; flex-shrink:0;"><span id="theme-toggle-icon">☾</span></button>
    </div>

    <article class="doc">
      <div class="doc-head">
        <div class="app-badge" style={`background:${app.bg}; color:${app.accent}; border-color:var(--line)`}>
          {app.icon.startsWith("/") ? <img src={app.icon} alt="" /> : <span>{app.icon}</span>}
          <span>{app.name}</span>
        </div>
        <h1>SpeedMaths Pro — Privacy Policy</h1>
        <p class="last">Last updated: 23 Nov 2026 · v1.3</p>
        <p class="intro">SpeedMaths Pro is a mental‐math trainer for competitive‐exam aspirants. You can play entirely without an account — the app creates only a random anonymous identifier so your scores can appear on the leaderboard. We collect the minimum data needed for the daily and weekly leaderboards and offline practice, and we never sell your data.</p>
        <div class="links">
          <a href={`/app/${app.slug}/delete-data/`} class="link">Delete my data →</a>
          <span class="sep">•</span>
          <a href="/" class="link">Dunite Labs home</a>
        </div>
      </div>

      <div class="sections">
        <section>
          <h2>What data we collect</h2>
          <p>When you first open SpeedMaths Pro, Firebase creates an anonymous authentication ID. This random identifier is not linked to your email, phone number, or any personal account — it only lets the app save your leaderboard scores and keep your streak in sync. No sign‐in or account is ever required to play.</p>
          <p>The leaderboard stores your score, average time, and an optional display name in Cloud Firestore under a day‐specific document, together with the level, XP, streak and badges shown next to your name on the board. If you never enter a display name, nothing that identifies you is stored.</p>
          <p>All practice history — quiz results, level progress, custom‐practice settings, and the list of questions you answered incorrectly — stays in a local SQLite database on your device. App preferences such as theme, reminder time, and the onboarding flag are saved in SharedPreferences. This data stays on your device and leaves it only as part of your leaderboard row.</p>
          <p><strong>We do not collect</strong> email addresses, phone numbers, contacts, precise or approximate location, camera or microphone data, photos, media files, messages, financial information, health or biometric data, or advertising IDs — and the app contains no advertising.</p>
        </section>

        <section>
          <h2>Permissions</h2>
          <p>The app requests the Internet permission, required for Firebase Authentication and Firestore, and an optional notification permission if you turn on the daily reminder. No sensitive permissions — such as location, contacts, camera, microphone, SMS, or call logs — are requested.</p>
        </section>

        <section>
          <h2>Third‐party services</h2>
          <p>We use Google Firebase: Firebase Authentication (anonymous sign‐in only) to generate and manage your random user ID; Cloud Firestore to store your daily and weekly leaderboard rows and optional display name; and Google Play Services, which Firebase depends on. The app does not use Google Sign‐In and never asks you for a Google account. All of these are covered by Google's own privacy policies and Data‐Processing Addendum.</p>
        </section>

        <section>
          <h2>Data retention & security</h2>
          <p>All network traffic is encrypted with TLS 1.2 or higher (Firebase enforces HTTPS). The on‐device SQLite database lives in the app's private sandbox — no other app can read it. No data is written to external storage. Firestore security rules ensure a user can only read or write their own leaderboard scores and cannot touch anyone else's.</p>
          <p>Daily and weekly leaderboard rows cover recent activity: the app removes your own older rows as part of normal use, so boards stay current and do not grow forever. Local data and preferences stay on your device until you tap <strong>Clear All Data</strong> in the app or clear the app's storage from Android Settings.</p>
        </section>

        <section>
          <h2>Children's privacy</h2>
          <p>SpeedMaths Pro is not directed to children under 13 (or the local equivalent). We do not knowingly collect data from children. If a parent discovers a child has entered a display name, contact us and we will delete it immediately.</p>
        </section>

        <section>
          <h2>Your rights</h2>
          <p>There is no account to manage — you play anonymously. You can view your history in the app's Profile screen and edit your display name and reminder time at any time. To erase the data on your device — quiz results, practice sessions, level progress and streak — open <strong>Profile → Settings → Clear All Data</strong>, or uninstall the app. Your leaderboard rows are removed automatically within a few days; to have them removed immediately, email us at <a href="mailto:dunitelabs.support@gmail.com">dunitelabs.support@gmail.com</a> with the subject "Delete my SpeedMaths Pro data" and we will confirm within 48 hours. See the <a href={`/app/${app.slug}/delete-data/`}>Delete Your Data</a> page for details.</p>
        </section>

        <section>
          <h2>Changes to this policy</h2>
          <p>Any material change will be posted on this page with a new "Last updated" date. The in‐app link always points to the current version.</p>
        </section>

        <section class="contact">
          <h2>Contact</h2>
          <p>Email: <a href="mailto:dunitelabs.support@gmail.com">dunitelabs.support@gmail.com</a> — we reply within 7 days. For Play Store, this page (<code>/app/speedmaths-pro/privacy/</code>) is the official privacy‐policy URL.</p>
        </section>
      </div>

      <div class="doc-foot">
        <a href={`/app/${app.slug}/`} class="back dark">← Back to {app.name}</a>
        <span>© {new Date().getFullYear()} Dunite Labs</span>
      </div>
    </article>
  </div>

<style>
  .page{ min-height:100dvh; background:var(--bg); padding-bottom:24px }
  .topbar{ max-width:var(--page-w); margin:0 auto; padding:14px 22px; display:flex; justify-content:space-between; gap:12px; align-items:center; font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.1em }
  .back{ display:flex; align-items:center; gap:8px; background:#0E0E0E; color:#fff; border:1.5px solid #0E0E0E; padding:6px 12px; font-weight:700; box-shadow:3px 3px 0 var(--line) }
  .back.dark{ background:var(--card); color:var(--ink); border-color:var(--line) }
  .back img{ width:20px; height:20px }
  .top-mono{ opacity:0.6 }
  .doc{ max-width:var(--page-w); margin:0 auto; padding:0 22px }
  .doc-head{ background:var(--card); border:2px solid var(--line); padding:22px; box-shadow:6px 6px 0 var(--line); margin-top:8px }
  .app-badge{ display:inline-flex; align-items:center; gap:8px; border:1.5px solid; padding:6px 10px; font-family:"Space Grotesk", sans-serif; font-weight:700; font-size:13px }
  .app-badge img{ width:22px; height:22px; object-fit:contain; background:#fff; border-radius:6px; padding:2px }
  h1{ margin:14px 0 6px; font-family:"Bricolage Grotesque", sans-serif; font-size:32px; letter-spacing:-0.04em; line-height:1 }
  .last{ font-family:"JetBrains Mono", monospace; font-size:11px; opacity:0.6; margin:0 }
  .intro{ margin:12px 0 0; font-family:"Instrument Serif", serif; font-size:18px; line-height:1.4 }
  .links{ margin-top:12px; display:flex; gap:10px; align-items:center; font-family:"JetBrains Mono", monospace; font-size:11px }
  .link{ border-bottom:1.5px solid var(--line); }
  .sep{ opacity:0.4 }
  .sections{ margin-top:16px; background:var(--card); border:2px solid var(--line); padding:22px; box-shadow:6px 6px 0 var(--line) }
  section{ padding:14px 0; border-bottom:1px solid var(--hair) }
  section:last-child{ border-bottom:none }
  h2{ margin:0 0 6px; font-family:"Space Grotesk", sans-serif; font-size:15px; letter-spacing:-0.02em }
  p{ margin:0 0 12px; font-size:14px; line-height:1.7; opacity:0.85 }
  .contact a{ text-decoration:underline }
  .doc-foot{ display:flex; justify-content:space-between; gap:12px; align-items:center; margin-top:16px; font-family:"JetBrains Mono", monospace; font-size:11px }
  @media(min-width:1000px){
    .doc{ display:grid; grid-template-columns:minmax(300px, 380px) minmax(0, 1fr); gap:22px; align-items:start }
    .doc-head{ margin-top:8px; position:sticky; top:16px }
    .sections{ margin-top:8px }
    .doc-foot{ grid-column:1 / -1; margin-top:0 }
  }
  @media(max-width:768px){
    .topbar{ padding:10px 14px; flex-wrap:wrap; gap:8px; }
    .back{ padding:5px 9px; font-size:11px; box-shadow:2px 2px 0 var(--line); order:1; }
    #theme-toggle{ order:2; margin-left:auto; }
    .top-mono{ font-size:9px; width:100%; text-align:left; order:3; }
    .doc{ padding:0 14px; }
    .doc-head{ padding:16px; box-shadow:4px 4px 0 var(--line); }
    h1{ font-size:clamp(22px, 6vw, 28px); }
    .intro{ font-size:16px; }
    .links{ flex-wrap:nowrap; gap:6px; font-size:clamp(9.5px, 2.6vw, 10px); justify-content:flex-start; white-space:nowrap; max-width:100%; overflow:hidden; }
    .links a{ white-space:nowrap; padding:4px 2px; flex-shrink:1; min-width:0; }
    .links .sep{ flex-shrink:0; }
    .sections{ padding:16px; box-shadow:4px 4px 0 var(--line); }
    .doc-foot{ flex-direction:column; align-items:stretch; text-align:center; }
    .doc-foot .back{ justify-content:center; }
  }
</style>
</Layout>