---
import Layout from "../../layouts/Layout.astro";
import { apps } from "../../data/apps.ts";
import { site } from "../../site";

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const app = apps.find((a) => a.slug === slug);
if (!app) throw new Error(`App not found: ${slug}`);

const jsonld = [
  {
    "@type": app.type.includes("Website") ? "WebSite" : "SoftwareApplication",
    name: app.name,
    description: app.description,
    applicationCategory: app.type,
    operatingSystem: app.platform,
    url: `/app/${app.slug}/`,
    image: app.screenshots?.[0] ? app.screenshots[0] : undefined,
    publisher: { "@type": "Organization", name: site.name, url: site.url },
    offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
  },
];
---

<Layout
  title={`${app.name} — Dunite Labs`}
  description={app.description}
  favicon={app.icon}
  path={`/app/${app.slug}/`}
  jsonld={jsonld}
>
  <div class="page" style={`--accent:${app.accent}; --app-bg:${app.bg}; --app-color:${app.color}`}>
    <div class="grain" aria-hidden="true"></div>

    <!-- top bar tiny -->
    <div class="topbar">
      <a href="/" class="back"><img src="/dunitelabs_logo.svg" alt="Dunite Labs" width="22" height="22" /> DUNITE LABS</a>
      <span class="top-mono">{app.platform} • {app.type} • 2024—NOW</span>
      <button id="theme-toggle" type="button" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Light / Dark" style="width:36px; height:36px; border-radius:50%; border:2px solid var(--line); background:var(--card); color:var(--ink); box-shadow:3px 3px 0 var(--line); cursor:pointer; display:grid; place-items:center; font-size:16px; flex-shrink:0;"><span id="theme-toggle-icon">☾</span></button>
    </div>

    <!-- BIG BRANDING HERO -->
    <header class="app-hero">
      <div class="hero-inner">
        <div class="big-icon-wrap">
          <div class="big-icon">
            {app.icon.startsWith("/") ? (
              <img class="glyph-img" src={app.icon} alt={`${app.name} logo`} />
            ) : (
              <span class="glyph">{app.icon}</span>
            )}
            <span class="icon-ring" aria-hidden="true"></span>
          </div>
          <div class="badge">{app.platform}</div>
        </div>

        <h1 class="app-name">{app.name.split(" ").map(w => w.toUpperCase()).join(" ")}</h1>
        <p class="app-tagline">“{app.tagline}”</p>
        <p class="app-desc">{app.description}</p>

        <div class="cta-row">
          {app.links.map((l) => (
            <a class="cta" href={l.href} target="_blank" rel="noopener">
              <span class="cta-icon" aria-hidden="true">
                {l.kind === "playstore" ? (
                  <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3 2.5L15.5 12 3 21.5V2.5Z"/><path fill="currentColor" d="M3 2.5L15.5 12 3 21.5Z" opacity=".6"/><path fill="currentColor" d="M20.5 12L15.5 12 3 21.5 16 15 20.5 12Z" opacity=".9"/><path fill="currentColor" d="M3 2.5L16 9 20.5 12 15.5 12Z" opacity=".7"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20ZM2 12h20M12 2a15 15 0 0 1 4 10a15 15 0 0 1-4 10A15 15 0 0 1 8 12A15 15 0 0 1 12 2Z"/></svg>
                )}
              </span>
              <span class="cta-label">
                <span class="cta-kicker">{l.kind === "playstore" ? "GET IT ON" : "OPEN"}</span>
                <span class="cta-title">{l.label}</span>
              </span>
              <span class="cta-arrow">↗</span>
            </a>
          ))}
        </div>

        <div class="stats">
          {app.stats.map(s => (
            <div class="stat">
              <div class="stat-val">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>

        <div class="legal-links">
          <a href={`/app/${app.slug}/privacy`}>Privacy Policy</a>
          <a href={`/app/${app.slug}/delete-data`}>Delete Data</a>
        </div>
      </div>

      <!-- huge ghost text -->
      <div class="ghost" aria-hidden="true">{app.short}</div>
    </header>

    <!-- SHOWCASE WALL -->
    <section class="showcase">
      <div class="show-head">
        <div class="show-left">
          <span class="kicker">SHOWCASE WALL — VISUAL PREVIEW</span>
          <h2>How it <em>feels</em> to use {app.name}.</h2>
          <p>Real screenshots — curated from each product.</p>
        </div>
        <div class="show-meta">
          <span class="pill accent">{app.name}</span>
          <span class="pill">{app.type}</span>
        </div>
      </div>

      <!-- unique mosaic: not generic grid -->
      <div class="mosaic">
        <!-- hero shot -->
        <div class="card phone">
          <div class="card-top"><span class="card-num">01 — HERO SCREEN</span><span class="dots">● ● ●</span></div>
          {app.screenshots?.length ? (
            <img class:list={["hero-shot-plain", app.platform === "WEB" ? "is-web" : "is-phone"]} src={app.screenshots[0]} alt={`${app.name} screenshot 1`} loading="lazy" />
          ) : (
            <div class="phone-frame">
              <div class="notch"></div>
              <div class="screen">
                {app.icon.startsWith("/") ? (
                  <img class="screen-glyph-img" src={app.icon} alt="" />
                ) : (
                  <div class="screen-glyph">{app.icon}</div>
                )}
                <div class="screen-title">{app.name}</div>
                <div class="screen-bar"></div>
                <div class="screen-lines"><span></span><span></span><span></span></div>
              </div>
            </div>
          )}
        </div>

        <div class="col">
          <div class="card feature">
            <div class="card-top"><span class="card-num">02 — WHY IT'S LOVED</span></div>
            <ul class="feat-list">
              {app.features.map(f => <li><span class="check">✓</span> {f}</li>)}
            </ul>
          </div>

        </div>

        <div class="card wide">
          <div class="card-top"><span class="card-num">03 — GALLERY</span><span class="hint">{app.screenshots?.length || 0} shots • click to expand</span></div>
          <div class="gallery gallery-plain">
            {app.screenshots?.map((src, idx) => (
              <div class="g-thumb">
                <span class="thumb-label">SCREEN {String.fromCharCode(65+idx)}</span>
                <a href={src} target="_blank" rel="noopener" class="thumb-box plain">
                  <img class:list={["thumb-shot-plain", app.platform === "WEB" ? "is-web" : "is-phone"]} src={src} alt={`${app.name} screen ${idx+1}`} loading="lazy" />
                </a>
              </div>
            ))}
          </div>

        </div>
      </div>

    </section>

    <!-- next project strip -->
    <nav class="next">
      <div class="next-head">
        <span class="next-kicker">KEEP EXPLORING</span>
        <span class="next-count">{apps.length - 1} MORE PROJECTS</span>
      </div>
      <div class="next-grid">
        {apps.filter(a=>a.slug!==app.slug).map(a=>(
          <a class="next-card" href={`/app/${a.slug}`} style={`--accent:${a.accent}; --card-bg:${a.bg}`}>
            <div class="next-icon-wrap" style={`background:${a.bg}`}>
              {a.icon.startsWith("/") ? <img class="next-img" src={a.icon} alt={`${a.name} logo`} /> : <span class="next-glyph">{a.icon}</span>}
            </div>
            <div class="next-main">
              <span class="next-pill">{a.platform}</span>
              <span class="next-name">{a.name}</span>
              <span class="next-tag">{a.tagline}</span>
            </div>
            <div class="next-cta"><span class="next-cta-label">Explore</span><span class="next-arrow">→</span></div>
            <div class="next-bar"></div>
          </a>
        ))}
      </div>
    </nav>

    <div class="back-bottom">
      <a href="/" class="back-bottom-link"><span>←</span> Back to Dunite Labs</a>
    </div>

    <footer class="mini-foot">
      <span>© {new Date().getFullYear()} Dunite Labs — {app.name}</span>
      <div class="mini-social">
        <a href={site.social.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href={site.social.x} target="_blank" rel="noopener" aria-label="X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>
    </footer>
  </div>

<style>
  .page{
    position:relative; overflow:clip; min-height:100dvh;
    background:
      radial-gradient(ellipse 900px 400px at 50% -8%, var(--accent) 0%, transparent 55%),
      linear-gradient(#0e0e0e0a 1px, transparent 1px),
      linear-gradient(90deg, #0e0e0e0a 1px, transparent 1px);
    background-size: auto, 34px 34px, 34px 34px;
    background-color:#F7F3EE;
  }
  .grain{ position:fixed; inset:0; pointer-events:none; opacity:0.04; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }

  .topbar{
    max-width:1280px; margin:0 auto; padding:14px 22px;
    display:flex; justify-content:space-between; gap:12px; align-items:center;
    font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.12em;
  }
  .back{ border:1.5px solid var(--line); background:#0E0E0E; color:#fff; padding:6px 12px; font-weight:700; box-shadow:3px 3px 0 var(--line); display:flex; align-items:center; gap:8px }
  .back img{ width:22px; height:22px; object-fit:contain; display:block }
  .top-mono{ opacity:0.6; text-align:right }

  .app-hero{
    position:relative; overflow:hidden;
    background:var(--app-bg); color:#fff;
    border-top:4px solid var(--line); border-bottom:4px solid var(--line);
    padding:36px 22px 30px;
  }
  .hero-inner{ max-width:980px; margin:0 auto; text-align:center; position:relative; z-index:2 }
  .big-icon-wrap{ display:inline-grid; place-items:center; gap:10px }
  .big-icon{
    position:relative;
    width:132px; height:132px; border-radius:30px;
    background:#fff; color:var(--app-bg);
    border:3px solid #fff; display:grid; place-items:center;
    box-shadow:0 20px 50px rgba(0,0,0,0.35); transform:rotate(-1deg);
  }
  .glyph{ font-size:64px; font-weight:800; line-height:1; color:var(--app-bg) }
  .glyph-img{ width:84px; height:84px; object-fit:contain; border-radius:18px; display:block; }
  .screen-glyph-img{ width:72px; height:72px; object-fit:contain; border-radius:18px; display:block; }
  .next-img{ width:28px; height:28px; object-fit:contain; border-radius:6px; display:block; }
  .icon-ring{ position:absolute; inset:-10px; border:1.5px dashed #ffffff55; border-radius:38px; transform:rotate(6deg) }
  .badge{
    font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.14em;
    background:var(--accent); color:var(--app-bg); border:1.5px solid var(--accent);
    padding:5px 10px; font-weight:700;
  }
  .app-name{
    margin:18px 0 0; font-family:"Bricolage Grotesque", sans-serif;
    font-size:clamp(38px, 7vw, 84px); line-height:0.88; letter-spacing:-0.06em; font-weight:800;
  }
  .app-tagline{
    margin:14px 0 0; font-family:"Instrument Serif", serif; font-size:clamp(18px, 2.4vw, 28px);
    font-style:italic; color:var(--accent); line-height:1.1;
  }
  .app-desc{
    margin:14px auto 0; max-width:640px; font-size:15px; line-height:1.6; opacity:0.85;
  }
  .cta-row{
    display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:24px;
  }
  .cta{
    display:flex; align-items:center; gap:12px;
    background:var(--accent); color:var(--app-bg);
    border:2px solid var(--accent); padding:12px 16px;
    box-shadow:4px 4px 0 rgba(0,0,0,0.35);
    transition:transform 120ms, box-shadow 120ms;
  }
  .cta:hover{ transform:translate(-1px,-1px); box-shadow:6px 6px 0 rgba(0,0,0,0.35) }
  .cta.ghost{ background:transparent; color:#fff; border-color:#ffffff55 }
  .cta-icon{ width:36px; height:36px; display:grid; place-items:center; border:1.5px solid currentColor; border-radius:10px; background:rgba(0,0,0,0.12) }
  .cta-label{ display:flex; flex-direction:column; text-align:left; line-height:1 }
  .cta-kicker{ font-family:"JetBrains Mono", monospace; font-size:9px; letter-spacing:0.14em; opacity:0.7 }
  .cta-title{ font-family:"Space Grotesk", sans-serif; font-weight:700; font-size:14px; letter-spacing:-0.02em }
  .cta-arrow{ font-size:18px; margin-left:4px }
  .stats{
    margin-top:26px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;
  }
  .stat{
    min-width:110px; background:#ffffff10; border:1.5px solid #ffffff18; padding:14px 16px; backdrop-filter:blur(6px);
  }
  .stat-val{ font-family:"Bricolage Grotesque", sans-serif; font-size:22px; font-weight:800; color:var(--accent); line-height:1 }
  .stat-label{ font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.12em; opacity:0.7; margin-top:4px; text-transform:uppercase }
  .legal-links{ margin-top:18px; display:flex; gap:8px; align-items:center; justify-content:center; flex-wrap:wrap; font-family:"JetBrains Mono", monospace; font-size:11px; }
  .legal-links a{ color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
  .legal-links span{ opacity:0.5 }

  .ghost{
    position:absolute; bottom:-12px; left:50%; transform:translateX(-50%);
    font-family:"Bricolage Grotesque", sans-serif; font-size:clamp(80px, 20vw, 220px);
    font-weight:800; letter-spacing:-0.07em; line-height:1;
    color:transparent; -webkit-text-stroke:1px #ffffff0e; white-space:nowrap; pointer-events:none;
  }

  /* SHOWCASE */
  .showcase{ max-width:1280px; margin:0 auto; padding:30px 22px 0 }
  .show-head{
    display:grid; grid-template-columns:1fr auto; gap:18px; align-items:start;
    border-bottom:1.5px solid var(--line); padding-bottom:18px;
  }
  .kicker{ font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.14em; border:1.5px solid var(--line); background:#fff; padding:6px 10px; }
  .show-head h2{ margin:12px 0 0; font-family:"Bricolage Grotesque", sans-serif; font-size:clamp(22px, 3vw, 38px); line-height:0.92; letter-spacing:-0.04em }
  .show-head h2 em{ font-family:"Instrument Serif", serif; font-weight:400; font-style:italic }
  .show-head p{ margin:8px 0 0; max-width:560px; color:#333; font-size:14px; line-height:1.5 }
  .show-meta{ display:flex; gap:8px; align-items:start; flex-wrap:wrap }
  .pill{ font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.1em; border:1.5px solid var(--line); padding:6px 10px; background:#fff; }
  .pill.accent{ background:var(--accent) }
  @media(max-width:800px){ .show-head{ grid-template-columns:1fr } }

  .mosaic{
    display:grid; grid-template-columns:380px 1fr; grid-template-rows:auto auto; gap:16px; margin-top:18px;
  }
  .mosaic .phone{ grid-row:1 / span 2 }
  .mosaic .wide{ grid-column:1 / -1 }
  @media(max-width:980px){ .mosaic{ grid-template-columns:1fr; } .mosaic .phone{ grid-row:auto } }

  .card{
    background:#fff; border:2px solid var(--line); box-shadow:6px 6px 0 var(--line);
    padding:16px; position:relative; overflow:hidden;
  }
  .card.phone, .card.wide{ background:transparent; border:none; box-shadow:none; padding:0; overflow:visible; }
  .card.phone .card-top, .card.wide .card-top{ background:#fff; border:1.5px solid var(--line); padding:10px 12px; box-shadow:3px 3px 0 var(--line); margin-bottom:14px }
  .card::before{ content:""; position:absolute; top:-8px; left:50%; transform:translateX(-50%) rotate(-1deg); width:88px; height:18px; background:var(--accent); border:1.5px solid var(--line); opacity:0.9 }
  .card.phone::before, .card.wide::before{ display:none }
  .card-top{ display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px }
  .card-num{ font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.12em; font-weight:700 }
  .dots{ opacity:0.5; letter-spacing:0.2em; font-size:10px }

  .phone-frame{
    background:var(--line); border-radius:32px; padding:10px 10px 14px; max-width:300px; margin:0 auto;
    box-shadow:0 18px 40px rgba(0,0,0,0.22), inset 0 0 0 2px #ffffff18;
    position:relative;
  }
  .notch{ width:90px; height:10px; background:#000; border-radius:0 0 10px 10px; margin:0 auto 10px }
  .hero-shot-plain.is-phone{ height:84vh; max-height:820px; width:auto; max-width:none; display:block; margin:0 auto; border-radius:0; background:transparent; filter:drop-shadow(0 18px 28px rgba(0,0,0,0.28)); }
  .hero-shot-plain.is-web{ width:100%; max-width:900px; height:auto; display:block; margin:0 auto; border-radius:8px; background:transparent; filter:drop-shadow(0 18px 28px rgba(0,0,0,0.18)); border:1.5px solid #00000012; }
