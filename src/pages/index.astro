---
import Layout from "../layouts/Layout.astro";
import { apps } from "../data/apps.ts";
---

<Layout title="DUNITE LABS — We build useful things.">
  <!-- VERTICAL SIDE TEXT + GRID BG -->
  <div class="page">
    <div class="grain" aria-hidden="true"></div>

    <!-- HERO: MASSIVE BRANDING, NO NAV -->
    <header class="hero">
      <div class="hero-top" style="display:flex; gap:12px; align-items:center;">
        <div class="eyebrow" style="flex:1;">
          <span class="dot"></span> EST. 2024 — INDIA <span class="sep">/</span> WE BUILD USEFUL THINGS
          <span class="right-mono">apps • websites • tools</span>
        </div>
        <button id="theme-toggle" type="button" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Light / Dark" style="width:38px; height:38px; border-radius:50%; border:2px solid var(--line); background:var(--card); color:var(--ink); box-shadow:3px 3px 0 var(--line); cursor:pointer; display:grid; place-items:center; font-size:16px; flex-shrink:0;"><span id="theme-toggle-icon">☾</span></button>
      </div>

      <div class="brand-wrap">
        <div class="logo-mark" aria-hidden="true">
          <img src="/dunitelabs_logo.svg" alt="Dunite Labs logo" width="118" height="118" />
        </div>

        <h1 class="brand">
          <span class="line1">DUNITE</span>
          <span class="line2">LABS<span class="trademark">®</span></span>
        </h1>
        <div class="hero-sub">
          <p class="tagline"><em>Developers who make</em> <b>apps, websites</b> & <b>tech tools</b> to solve real problems — <u>simply, quickly, beautifully.</u></p>
          <div class="hero-actions">
            <a class="stamp" href="#work">↓ OUR WORK</a>
            <span class="hero-mono">3 SHIPPED — MORE COOKING →</span>
          </div>
          <div class="hero-left-extra">
            <span>✦ Apps</span><span>•</span><span>Websites</span><span>•</span><span>Tools</span>
            <span class="left-extra-muted">Est. 2024 • India • Remote</span>
          </div>
        </div>

        <div class="hero-sticks">
          {apps.map((app) => (
            <a href={`/app/${app.slug}`} class="stick" style={`--accent:${app.accent}`}>
              <span class="stick-pin" aria-hidden="true"></span>
              {app.icon.startsWith("/") ? (
                <img class="stick-logo" src={app.icon} alt={`${app.name} logo`} />
              ) : (
                <span class="stick-glyph">{app.icon}</span>
              )}
              <span class="stick-name">{app.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- thin rule + manifesto -->
      <div class="hero-rule"></div>
      <div class="hero-foot">
        <div class="foot-left">BUILT IN INDIA, USED EVERYWHERE.</div>
        <div class="foot-right">SCROLL ↓</div>
      </div>
    </header>

    <!-- WORK: 3 APPS, UNIQUE STRIPS (NOT GENERIC CARDS) -->
    <section id="work" class="work">
      <div class="work-head">
        <span class="work-label">SELECTED WORK — 01 / 03</span>
        <h2>Three small tools.<br><span class="serif">Loved by real people.</span></h2>
      </div>

      <div class="stack">
        {apps.map((app, i) => (
          <a class="app-card" href={`/app/${app.slug}`} style={`--accent:${app.accent}; --strip-bg:${app.bg}`}>
            <div class="card-art" aria-hidden="true" style={`background:${app.bg}`}>
              <span class="card-num">0{i+1}</span>
              <span class="card-platform">{app.platform}</span>
              {app.icon.startsWith("/") ? (
                <img class="card-icon" src={app.icon} alt="" />
              ) : (
                <span class="card-glyph">{app.icon}</span>
              )}
              <span class="card-badge" style={`background:${app.accent}`}>↗</span>
            </div>
            <div class="card-info">
              <div class="card-main">
                <div class="card-kicker">
                  <span class="pill" style={`background:${app.accent}`}>{app.type}</span>
                </div>
                <h3 class="card-title">{app.name}</h3>
                <p class="card-desc">{app.tagline}</p>
              </div>
              <div class="card-side">
                <span class="side-label">WHAT YOU GET</span>
                <ul class="card-features">
                  {(app.slug === "speedmaths-pro" ? app.features.slice(0,4) : app.features).map(f => (
                    <li><span class="check">✓</span>{f}</li>
                  ))}
                </ul>
                <span class="card-cta">Explore <b>→</b></span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </section>

    <footer class="foot">
      <div class="foot-inner">
        <div class="foot-brand"><img src="/dunitelabs_logo.svg" alt="" width="32" height="32" /> DUNITE LABS</div>
        <div class="foot-copy">© {new Date().getFullYear()} Dunite Labs. Built with care in India. <span class="mono">support.dunitelabs@gmail.com</span></div>
      </div>
      <div class="foot-big" aria-hidden="true">DUNITE LABS — DUNITE LABS — DUNITE LABS</div>
    </footer>
  </div>

<style>
  .page{
    position:relative;
    overflow:clip;
    background:
      radial-gradient(ellipse 1200px 500px at 20% -10%, #fff 0%, transparent 60%),
      linear-gradient(#0e0e0e0a 1px, transparent 1px),
      linear-gradient(90deg, #0e0e0e0a 1px, transparent 1px);
    background-size: auto, 36px 36px, 36px 36px;
    min-height:100dvh;
  }
  .grain{
    position:fixed; inset:0; pointer-events:none; opacity:0.035;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* HERO */
  .hero{
    min-height:92dvh;
    padding:18px 22px 0;
    border-bottom:4px solid var(--line);
    display:flex; flex-direction:column;
  }
  .hero-top{ max-width:1400px; width:100%; margin:0 auto; }
  .eyebrow{
    display:flex; gap:10px; align-items:center; flex-wrap:wrap;
    font-family:"JetBrains Mono", monospace;
    font-size:11px; letter-spacing:0.14em; text-transform:uppercase;
    border:1.5px solid var(--line); padding:10px 14px; background:#fff;
    box-shadow:4px 4px 0 var(--line);
  }
  .dot{width:9px; height:9px; background:var(--ink); border-radius:50%; display:inline-block; animation:pulse 1.8s infinite}
  @keyframes pulse{0%,100%{opacity:1} 50%{opacity:0.4}}
  .sep{opacity:0.3}
  .right-mono{margin-left:auto; opacity:0.7}
  @media(max-width:720px){ .right-mono{display:none} }

  .brand-wrap{
    max-width:1400px; width:100%; margin:0 auto;
    flex:1;
    display:grid;
    grid-template-columns:118px 1fr 320px;
    gap:16px 14px;
    align-items:stretch;
    padding:28px 0 22px;
  }
  .logo-mark{
    width:128px; height:128px;
    background:var(--ink);
    border:3px solid var(--ink);
    border-radius:26px;
    padding:0;
    box-shadow:6px 6px 0 var(--ink);
    transform:rotate(-1.2deg);
    overflow:hidden;
    display:grid; place-items:center;
  }
  .logo-mark img{ width:100%; height:100%; object-fit:contain; display:block; padding:4%; transform:scale(1.2); }
  .brand{
    margin:0; line-height:0.82;
    font-family:"Bricolage Grotesque", sans-serif;
    font-weight:800; letter-spacing:-0.05em;
    text-transform:uppercase;
  }
  .line1, .line2{ display:block; }
  .line1{
    font-size:clamp(54px, 12vw, 168px);
    -webkit-text-stroke:2.2px var(--ink);
    color:transparent;
    letter-spacing:-0.06em;
  }
  .line2{
    font-size:clamp(54px, 12vw, 168px);
    color:var(--ink);
    position:relative;
    display:inline-block;
  }
  .trademark{
    font-size:0.18em; vertical-align:super; margin-left:6px;
    border:1.5px solid var(--ink); border-radius:50%; width:1.6em; height:1.6em;
    display:inline-flex; align-items:center; justify-content:center;
    font-weight:700; transform:translateY(-0.6em);
  }
  .hero-sub{
    grid-column:2;
    display:flex; gap:24px; align-items:end; flex-wrap:wrap;
    padding-top:6px;
  }
  .tagline{
    margin:0; max-width:560px;
    font-family:"Instrument Serif", serif;
    font-size:clamp(18px, 2vw, 24px);
    line-height:1.25;
    color:#1a1a1a;
  }
  .tagline b{ font-family:"Space Grotesk", sans-serif; font-weight:700; }
  .tagline u{ text-decoration:underline; text-decoration-thickness:2px; text-underline-offset:4px; }
  .hero-actions{ display:flex; gap:14px; align-items:center; }
  .stamp{
    font-family:"JetBrains Mono", monospace;
    font-size:12px; letter-spacing:0.12em;
    background:var(--ink); color:var(--bg);
    padding:12px 16px;
    border:2px solid var(--ink);
    box-shadow:3px 3px 0 #000;
  }
  .hero-mono{
    font-family:"JetBrains Mono", monospace;
    font-size:11px; letter-spacing:0.08em; opacity:0.6
  }
  .hero-sticks{
    grid-column:3; grid-row:1 / span 2;
    position:relative;
    min-height:380px;
    align-self:stretch;
  }
  .stick{
    position:absolute;
    width:148px;
    background:#fff;
    border:2px solid #0E0E0E;
    border-top:4px solid var(--accent);
    padding:18px 10px 10px;
    box-shadow:5px 5px 0 #0E0E0E;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    text-align:center;
    text-decoration:none; color:#0E0E0E;
    transition:transform 150ms, box-shadow 150ms;
  }
  .stick:hover{ transform:translateY(-2px) rotate(var(--r, 0deg)); box-shadow:7px 7px 0 #0E0E0E; }
  .stick:nth-child(1){ left:10px; top:14px; transform:rotate(-2.6deg); }
  .stick:nth-child(1):hover{ transform:rotate(-2.6deg) translateY(-3px); }
  .stick:nth-child(2){ left:132px; top:138px; transform:rotate(2.4deg); }
  .stick:nth-child(2):hover{ transform:rotate(2.4deg) translateY(-3px); }
  .stick:nth-child(3){ left:18px; top:262px; transform:rotate(-1.4deg); }
  .stick:nth-child(3):hover{ transform:rotate(-1.4deg) translateY(-3px); }
  .stick-pin{
    position:absolute;
    top:-9px; left:50%; transform:translateX(-50%);
    width:16px; height:16px;
    background:radial-gradient(circle at 35% 35%, #FF6B6B 0%, #E03131 62%, #8D0F0F 100%);
    border:2px solid #5A0A0A;
    border-radius:50%;
    box-shadow:0 2px 5px rgba(0,0,0,0.3), inset 0 1px 2px rgba(255,255,255,0.7);
  }
  .stick-logo{ width:52px; height:52px; object-fit:contain; border-radius:12px; background:#fff; border:1.5px solid #0E0E0E; padding:4px; display:block; }
  .stick-glyph{ width:52px; height:52px; display:grid; place-items:center; background:#fff; border:1.5px solid #0E0E0E; border-radius:12px; font-weight:800; font-size:20px; color:#0E0E0E; }
  .stick-name{
    font-family:"Bricolage Grotesque", sans-serif; font-weight:800; font-size:13px; line-height:1.1; letter-spacing:-0.03em;
  }
  .hero-left-extra{
    display:flex; gap:8px; align-items:center; flex-wrap:wrap;
    margin-top:14px; padding-top:12px; border-top:1.5px dashed #0E0E0E22;
    font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.08em;
  }
  .hero-left-extra span{ opacity:0.7; }
  .left-extra-muted{ margin-left:auto; opacity:0.5; font-size:9px; }

  html[data-theme="dark"] .stick{ background:#fff !important; border-color:#F7F3EE !important; color:#0E0E0E !important; box-shadow:5px 5px 0 #F7F3EE !important; }
  @media(max-width:900px){
    .brand-wrap{ grid-template-columns:84px 1fr; }
    .logo-mark{ width:84px; height:84px; border-radius:18px; padding:0 }
    .hero-sub{ grid-column:1 / -1; }
    .hero-sticks{ display:none }
  }
  @media(max-width:720px){
    .hero{ min-height:0; padding-top:14px; }
    .brand-wrap{ padding:24px 0 14px; }
  }

  .hero-rule{ height:1.5px; background:var(--ink); margin-top:auto; }
  .hero-foot{
    display:flex; justify-content:space-between;
    font-family:"JetBrains Mono", monospace;
    font-size:11px; letter-spacing:0.12em;
    padding:10px 0 14px;
    max-width:1400px; width:100%; margin:0 auto;
  }

  /* WORK */
  .work{ max-width:1400px; margin:0 auto; padding:42px 22px 0; }
  .work-head{
    display:grid; grid-template-columns:280px 1fr; gap:24px; align-items:start;
    padding-bottom:28px; border-bottom:1.5px solid var(--ink);
  }
  .work-label{
    font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.14em;
    border:1.5px solid var(--ink); padding:8px 10px; background:#fff; width:fit-content;
  }
  .work-head h2{
    margin:0; font-family:"Bricolage Grotesque", sans-serif;
    font-size:clamp(28px, 4vw, 54px); line-height:0.95; letter-spacing:-0.04em;
  }
  .work-head .serif{ font-family:"Instrument Serif", serif; font-weight:400; font-style:italic; }
  @media(max-width:800px){ .work-head{ grid-template-columns:1fr; } }

  .stack{ display:flex; flex-direction:column; margin-top:22px; }

  .app-card{
    position:relative;
    display:grid;
    grid-template-columns:300px 1fr;
    align-items:stretch;
    background:#fff;
    border:2px solid var(--ink);
    margin-bottom:20px;
    box-shadow:6px 6px 0 var(--ink);
    transition:transform 160ms, box-shadow 160ms;
    overflow:hidden;
    text-decoration:none; color:inherit;
  }
  .app-card:hover{ transform:translate(-2px,-2px); box-shadow:10px 10px 0 var(--ink); }
  .app-card:active{ transform:translate(1px,1px); box-shadow:3px 3px 0 var(--ink); }

  .card-art{
    position:relative;
    display:grid; place-items:center;
    min-height:200px;
    border-right:2px solid var(--ink);
    overflow:hidden;
  }
  .card-num{
    position:absolute; top:12px; left:14px;
    font-family:"Bricolage Grotesque", sans-serif; font-size:28px; font-weight:800;
    -webkit-text-stroke:1.4px #ffffff55; color:transparent; letter-spacing:-0.03em;
  }
  .card-platform{
    position:absolute; top:16px; right:14px;
    font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.14em;
    color:#ffffffaa;
  }
  .card-icon{
    width:110px; height:110px; object-fit:contain; border-radius:24px;
    background:#fff; padding:8px; border:3px solid #fff;
    box-shadow:0 16px 34px rgba(0,0,0,0.35); transform:rotate(-2deg);
  }
  .card-glyph{ font-size:72px; font-weight:800; color:#fff; line-height:1 }
  .card-badge{
    position:absolute; right:14px; bottom:14px;
    width:40px; height:40px; display:grid; place-items:center;
    border:2px solid var(--ink); border-radius:50%; font-size:18px; font-weight:800;
  }

  .card-info{
    display:grid;
    grid-template-columns:1.3fr 1fr;
    gap:20px 32px;
    align-items:stretch;
    padding:26px 28px;
  }
  .card-main{
    display:flex; flex-direction:column; align-items:flex-start; gap:10px;
  }
  .card-kicker{ display:flex; gap:8px }
  .pill{
    font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.1em;
    border:1.5px solid var(--ink); padding:4px 9px; font-weight:600;
  }
  .card-title{
    margin:0; font-family:"Bricolage Grotesque", sans-serif;
    font-size:clamp(24px, 3vw, 40px); line-height:0.95; letter-spacing:-0.04em;
  }
  .card-desc{
    margin:0; font-family:"Instrument Serif", serif; font-size:18px; line-height:1.4; opacity:0.8;
  }
  .card-side{
    display:flex; flex-direction:column; align-items:flex-start; gap:12px;
    border-left:1.5px solid var(--line); padding-left:28px;
  }
  .side-label{
    font-family:"JetBrains Mono", monospace; font-size:10px; letter-spacing:0.16em;
    background:var(--ink); color:var(--bg); padding:4px 8px;
  }
  .card-features{
    list-style:none; margin:0; padding:0;
    display:flex; flex-direction:column; gap:8px; width:100%;
  }
  .card-features li{
    display:flex; align-items:center; gap:9px;
    font-family:"Space Grotesk", sans-serif; font-size:13px; font-weight:600; line-height:1.2;
    border:1.5px solid var(--line); background:#F7F3EE; padding:8px 10px;
  }
  .card-features .check{
    width:18px; height:18px; flex-shrink:0; display:grid; place-items:center;
    background:var(--accent); border:1.5px solid var(--ink); border-radius:50%;
    font-size:11px; font-weight:800;
  }
  .card-cta{
    margin-top:auto;
    font-family:"JetBrains Mono", monospace; font-size:12px; letter-spacing:0.12em; text-transform:uppercase;
    border-bottom:2px solid var(--ink); padding-bottom:3px;
  }
  .card-cta b{ margin-left:6px; transition:transform 160ms; display:inline-block }
  .app-card:hover .card-cta b{ transform:translateX(4px) }

  @media(max-width:900px){
    .card-info{ grid-template-columns:1fr; }
    .card-side{ border-left:none; padding-left:0; border-top:1.5px solid var(--line); padding-top:16px }
  }
  @media(max-width:760px){
    .app-card{ grid-template-columns:1fr; }
    .card-art{
      min-height:170px;
      border-right:none; border-bottom:2px solid var(--ink);
    }
  }

  /* === MOBILE OPTIMIZATIONS === */
  @media(max-width:480px){
    .hero{ padding:12px 14px 0; }
    .eyebrow{ font-size:9px; padding:8px 10px; box-shadow:3px 3px 0 var(--line); gap:6px }
    .brand-wrap{ grid-template-columns:56px 1fr; gap:12px; padding:18px 0 12px; }
    .logo-mark{ width:56px; height:56px; border-radius:14px; box-shadow:4px 4px 0 var(--ink); }
    .line1,.line2{ font-size:clamp(32px, 13vw, 52px); }
    .trademark{ font-size:0.16em; transform:translateY(-0.4em); }
    .hero-sub{ gap:14px; }
    .tagline{ font-size:clamp(15px, 4.2vw, 18px); line-height:1.35; }
    .stamp{ padding:10px 12px; font-size:11px; }
    .hero-mono{ font-size:10px; }
    .hero-foot{ font-size:9px; padding:8px 0 10px; }
    .work{ padding:24px 14px 0; }
    .work-head h2{ font-size:clamp(22px, 7vw, 28px); }
    .work-label{ font-size:10px; }
    .app-card{ box-shadow:4px 4px 0 var(--ink); margin-bottom:14px; }
    .card-art{ min-height:140px; }
    .card-icon{ width:80px; height:80px; border-radius:16px; padding:6px; border-width:2px; }
    .card-num{ font-size:20px; top:10px; left:10px; }
    .card-platform{ font-size:8px; top:12px; right:10px; }
    .card-badge{ width:32px; height:32px; font-size:14px; right:10px; bottom:10px; }
    .card-info{ padding:16px; gap:14px; }
    .card-title{ font-size:clamp(20px, 6vw, 26px); }
    .card-desc{ font-size:15px; }
    .pill{ font-size:9px; padding:3px 7px; }
    .card-features li{ font-size:12px; padding:7px 8px; }
    .foot{ padding:16px 14px; margin-top:24px; }
    .foot-inner{ font-size:10px; }
    .foot-brand{ font-size:15px; }
    .foot-big{ font-size:clamp(14px, 8vw, 32px); padding-top:10px; }
  }
  @media(max-width:375px){
    .brand-wrap{ grid-template-columns:52px 1fr; }
    .logo-mark{ width:52px; height:52px; }
    .card-info{ padding:14px; }
  }

  /* FOOTER */
  .foot{
    margin-top:42px; border-top:4px solid var(--ink); background:var(--ink); color:var(--bg);
    padding:22px; overflow:hidden;
  }
  .foot-inner{
    max-width:1400px; margin:0 auto;
    display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap;
    font-family:"JetBrains Mono", monospace; font-size:11px; letter-spacing:0.08em;
  }
  .foot-brand{ font-family:"Bricolage Grotesque", sans-serif; font-size:18px; letter-spacing:-0.03em; font-weight:800; display:flex; align-items:center; gap:10px }
  .foot-brand img{ width:36px; height:36px; border-radius:8px; background:transparent; padding:0; border:none; filter:none; transform:scale(1.35); object-fit:contain }
  .mono{ opacity:0.8 }
  .foot-big{
    max-width:1400px; margin:18px auto 0;
    font-family:"Bricolage Grotesque", sans-serif;
    font-size:clamp(22px, 7vw, 86px);
    line-height:1; letter-spacing:-0.05em; white-space:nowrap;
    color:transparent; -webkit-text-stroke:1px #ffffff22;
    border-top:1px solid #ffffff1a; padding-top:14px;
  }
</style>
</Layout>
